msgstr "Améliorer mes Moteurs"

#: src-en/data/events_sector_radikal.xml:1689
msgid ""
"data/events_sector_radikal.xml$//event[@name=\"RKS_GARAGE_BAM_SYSTEMS\"]/choice[2]/event/choice/event/choice[@req=\"shields\"]/text"
msgstr "Améliorer mes Boucliers"

#: src-en/data/events_sector_radikal.xml:1694
msgid ""
"data/events_sector_radikal.xml$//event[@name=\"RKS_GARAGE_BAM_SYSTEMS\"]/choice[2]/event/choice/event/choice[@req=\"weapons\"]/text"
msgstr "Améliorer mon Contrôle des armes"

#: src-en/data/events_sector_radikal.xml:1699
msgid ""
"data/events_sector_radikal.xml$//event[@name=\"RKS_GARAGE_BAM_SYSTEMS\"]/choice[2]/event/choice/event/choice[5]/text"
msgstr ""
"Attendez une minute... nous n'avons même pas de systèmes applicables !"

#: src-en/data/events_sector_radikal.xml:1701
msgid ""
"data/events_sector_radikal.xml$//event[@name=\"RKS_GARAGE_BAM_SYSTEMS\"]/choice[2]/event/choice/event/choice[5]/event/text"
msgstr ""
"\"Typique problème de compétence de décision. Rapport rejeté.\n"
"\t\t\t\t\t\t\t\tProcédure 100% terminée. Vaisseau de soins après coup déployé. Au revoir.\"\n"
"\n"
"\t\t\t\t\t\t\tMaintenant que vous pouvez voir le prix flagrant des réparations, vous comprenez comment cette entreprise peut rester à flot...\""

#: src-en/data/events_sector_radikal.xml:1715
msgid ""
"data/events_sector_radikal.xml$//event[@name=\"RKS_GARAGE_BAM_SYSTEMS\"]/choice[3]/text"
msgstr "Non merci, mais que diriez-vous si nous en embauchions quelques-uns ?"

#: src-en/data/events_sector_radikal.xml:1717
msgid ""
"data/events_sector_radikal.xml$//event[@name=\"RKS_GARAGE_BAM_SYSTEMS\"]/choice[3]/event/text"
msgstr ""
"\"Acceptation déclarée. Qui s'en soucie, l'existence est une douleur de "
"toute façon. Vous feriez bien de nous trouver des trucs à détruire. Sinon, "
"les vôtres feront l'affaire.\""

#: src-en/data/events_sector_radikal.xml:1724
msgid ""
"data/events_sector_radikal.xml$//event[@name=\"RKS_GARAGE_BAM_SYSTEMS\"]/choice[3]/event/choice/text"
