msgstr "(Unique Mantis) TskKAK ! Laissez passer ! Mission secrète."

#: src-en/data/events_sector_radikal.xml:3110
msgid ""
"data/events_sector_radikal.xml$//event[@name=\"RKS_LAB_PUNK_AMBUSH\"]/choice[2]/text"
msgstr "...C'est logique, en fait."

