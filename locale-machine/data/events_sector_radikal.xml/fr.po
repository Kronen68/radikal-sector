#: src-en/data/events_sector_radikal.xml:1689
msgid ""
"data/events_sector_radikal.xml$//event[@name=\"RKS_BIL_BAM_SYSTEMS\"]/choice[3]/event/text"
msgstr ""
"\"Avons-nous échoué à vous identifier comme le nouveau vaisseau videur de poubelles ? Peu probable. Mais procédez. Je m'en fiche.\"\n"
"\t\t\t\tPas du genre à laisser passer de la ferraille gratuite, vous choisissez parmi ce qu'il reste des clients précédents."

#: src-en/data/events_sector_radikal.xml:1701
msgid ""
