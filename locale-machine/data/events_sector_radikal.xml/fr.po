"\t\t\t\n"
"\t\t\t\"Attendez, quel rapport avec moi ? Ils ne savent même pas... Oh, peu importe.\""

#: src-en/data/events_sector_radikal.xml:2216
msgid ""
"data/events_sector_radikal.xml$//ship[@name=\"SHIP_RKS_DEFROMORIUS_SUSPICIOUS\"]/surrender/choice[1]/text"
