#: src-en/data/events.xml.append:3713
msgid ""
"data/events.xml.append$//event[@name=\"SHIP_SMUGGLER_RK_LASERS_SURRENDER\"]/choice[1]/event/choice/text"
msgstr "Aller vérifier leur proie potentielle."

#: src-en/data/events.xml.append:3724
msgid "data/events.xml.append$//event[@name=\"THIEVES_RK_LASERS_REWARD\"]/text"
msgstr "\"Sans vous, nous étions cuits. Prenez ceci en remerciement.\""

#: src-en/data/events.xml.append:3728
msgid ""
"data/events.xml.append$//event[@name=\"THIEVES_RK_LASERS_REWARD\"]/choice/text"
msgstr "Que voulaient-ils de vous ?"

#: src-en/data/events.xml.append:3733
msgid ""
"data/events.xml.append$//event[@name=\"THIEVES_RK_LASERS_REWARD_CREWKILL\"]/text"
msgstr "\"Sans vous, nous étions cuits. Prenez ceci en remerciement.\""

#: src-en/data/events.xml.append:3737
msgid ""
"data/events.xml.append$//event[@name=\"THIEVES_RK_LASERS_REWARD_CREWKILL\"]/choice/text"
msgstr "Que voulaient-ils de vous ?"

#: src-en/data/events.xml.append:3743
msgid "data/events.xml.append$//event[@name=\"THIEVES_RK_LASERS_END\"]/text"
msgstr ""
"\"L'habituel, de la technologie locale. Vous comprenez sûrement que nous ne pouvons pas simplement vous la donner non plus.\"\n"
"\t\tUne voix dans le fond de votre tête vous dit que vous auriez dû les tuer à ce moment-là... mais vous gardez votre avidité sous contrôle et écartez ces pensées intrusives.\n"
"\t\t\n"
"\t\t\"Cependant, nous pouvons vous fournir une arme laser non-RadiKal qui correspond au style d'une sous-faction RK, ce ne serait que justice. Laquelle est-ce ?\""

#: src-en/data/events.xml.append:3750
msgid ""
"data/events.xml.append$//event[@name=\"THIEVES_RK_LASERS_END\"]/choice[1]/text"
msgstr ""

#: src-en/data/events.xml.append:3752
msgid ""
"data/events.xml.append$//event[@name=\"THIEVES_RK_LASERS_END\"]/choice[1]/event/text"
