"data/events.xml.append$//event[@name=\"SHIP_SMUGGLER_RK_LASERS_SURRENDER\"]/choice[1]/event/choice/text"
msgstr "Allez vérifier leur proie potentielle."

#: src-en/data/events.xml.append:2431
msgid "data/events.xml.append$//event[@name=\"THIEVES_RK_LASERS_REWARD\"]/text"
msgstr "\"Sans vous, on était cuits. Prenez ceci en remerciement.\""

#: src-en/data/events.xml.append:2435
