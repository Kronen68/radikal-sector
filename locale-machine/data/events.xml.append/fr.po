#: src-en/data/events.xml.append:2926
msgid "data/events.xml.append$//textList[@name=\"EMPTY_RADIKAL\"]/text[1]"
msgstr ""
"Vous arrivez à la balise et êtes soulagé de faire une pause, car personne "
"ici ne semble se soucier de la technologie que vous avez ou n'avez pas."

#: src-en/data/events.xml.append:2927
msgid "data/events.xml.append$//textList[@name=\"EMPTY_RADIKAL\"]/text[2]"
