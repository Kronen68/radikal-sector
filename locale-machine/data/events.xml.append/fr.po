#: src-en/data/events.xml.append:737
msgid ""
"data/events.xml.append$//event[@name=\"RK_A_OUTSIDE_POLICE_NUMBER2_QUEST_START\"]/choice[3]/event/choice[@req=\"RK_HAS_GEAR_SURRENDERABLE_TO_RK_A\""
" and @lvl=\"0\"]/event/choice[1]/event/text"
msgstr ""
"\"Aussi bien. Maintenant, si vous souhaitez acquérir de l'équipement Anti-RK, n'hésitez pas à vous équiper. Nous sommes la seule organisation autorisée à le vendre.\n"
"\t\t\t\t\t\t\t\t'Que l'Ordre Prévale'.\""

#: src-en/data/events.xml.append:745
msgid ""
"data/events.xml.append$//event[@name=\"RK_A_OUTSIDE_POLICE_NUMBER2_QUEST_START\"]/choice[3]/event/choice[@req=\"RK_HAS_GEAR_SURRENDERABLE_TO_RK_A\""
" and @lvl=\"0\"]/event/choice[2]/text"
msgstr "Ils sont allés par là."

#: src-en/data/events.xml.append:747
msgid ""
"data/events.xml.append$//event[@name=\"RK_A_OUTSIDE_POLICE_NUMBER2_QUEST_START\"]/choice[3]/event/choice[@req=\"RK_HAS_GEAR_SURRENDERABLE_TO_RK_A\""
" and @lvl=\"0\"]/event/choice[2]/event/text"
msgstr ""
"\"Merci pour votre coopération.\" Ils jettent immédiatement un paquet de "
"récompense standard par un sas et partent. Espérons que par un heureux "
"hasard, il y ait effectivement des RadiKals par là, ou vous feriez mieux "
"d'espérer ne jamais revoir ce vaisseau."

#: src-en/data/events.xml.append:754
