#: src-en/data/events.xml.append:1099
msgid ""
"data/events.xml.append$//eventList[@name=\"DEFEAT_RK_A_POLICE_LOOT_CHANCE\"]/event[2]/text"
msgstr ""
"Vous remarquez une arme qui est encore intacte et vous la ramenez à bord.\n"
"\t\t\tIl est temps de sauter loin des tirs d'artillerie."

#: src-en/data/events.xml.append:1104
