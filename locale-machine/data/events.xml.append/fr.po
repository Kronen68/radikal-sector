"data/events.xml.append$//event[@name=\"THIEVES_RK_MISSILES\"]/choice[@req=\"weapons\"]/text"
msgstr "(Armes améliorées) Réclamez la proie pour vous-même."

#: src-en/data/events.xml.append:2515
msgid ""
"data/events.xml.append$//event[@name=\"THIEVES_RK_MISSILES\"]/choice[@req=\"weapons\"]/event/text"
msgstr ""
"\"Woh hoh hoh, hé, attendez, c'est à nous-\" Ils changent rapidement d'avis "
