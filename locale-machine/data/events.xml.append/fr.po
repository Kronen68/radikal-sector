#: src-en/data/events.xml.append:2497
msgid "data/events.xml.append$//event[@name=\"THIEVES_RK_MISSILES\"]/text"
msgstr ""
"Il semble qu'un vaisseau RadiKal endommagé maniant des missiles soit attaqué"
