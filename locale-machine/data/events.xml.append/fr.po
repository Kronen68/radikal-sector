#: src-en/data/events.xml.append:1901
msgid ""
"data/events.xml.append$//event[@name=\"RADIKAL_PHILO_INTEL_REAL\"]/choice[5]/event/text"
msgstr ""
"Emporté par sa fragilité physique, vous décidez que discuter ne sera jamais "
