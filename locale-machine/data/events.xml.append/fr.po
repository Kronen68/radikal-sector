#: src-en/data/events.xml.append:2501
msgid ""
"data/events.xml.append$//event[@name=\"THIEVES_RK_MISSILES\"]/choice[1]/text"
msgstr "Sauvez les RadiKals."

#: src-en/data/events.xml.append:2503
msgid ""
"data/events.xml.append$//event[@name=\"THIEVES_RK_MISSILES\"]/choice[1]/event/text"
msgstr ""
"Vous ne laissez pas d'autre choix au vaisseau contrebandier que de vous "
"combattre alors que vous volez vers lui à pleine vitesse."

#: src-en/data/events.xml.append:2506
msgid ""
"data/events.xml.append$//event[@name=\"THIEVES_RK_MISSILES\"]/choice[1]/event/choice/text"
msgstr ""

#: src-en/data/events.xml.append:2513
