#: src-en/data/text_misc.xml.append:55
msgid "data/text_misc.xml.append$//text[@name=\"RK_lore_DJMOD_BAM_FISSUREBEAM\"]"
msgstr ""
"Tampon de qualité : \"A one-shot avec succès un transport civil de CLASSE "
"ÉLÉPHANT complet !\""

#: src-en/data/text_misc.xml.append:56
msgid "data/text_misc.xml.append$//text[@name=\"RK_lore_RK_HEAVY_POPPER_1\"]"
msgstr ""
"Tampon de qualité : \"A ravagé le Camouflage des Vaisseaux furtifs de la "
"Fédé en UN tir ! Proie FACILE après ça.\""

#: src-en/data/text_misc.xml.append:57
msgid "data/text_misc.xml.append$//text[@name=\"RK_lore_RK_HEAVY_POPPER_2\"]"
msgstr ""

#: src-en/data/text_misc.xml.append:58
msgid "data/text_misc.xml.append$//text[@name=\"RK_lore_RK_HEAVY_POPPER_3\"]"
msgstr ""
"Tampon de qualité : \"TOUS les Seigneurs de guerre en ont un, pour quand il "
"est temps de faire comprendre qu'ils PARLENT SÉRIEUX !\""

#: src-en/data/text_misc.xml.append:59
msgid "data/text_misc.xml.append$//text[@name=\"lore_RK_UNLOADER\"]"
msgstr ""
"Tampon de qualité : \"Démoli TOUS les vaisseaux tests réticents qui "
"manquaient de solides drones de défense ! Et toutes les finances des "
"utilisateurs.\""

#: src-en/data/text_misc.xml.append:61
msgid ""
"data/text_misc.xml.append$//text[@name=\"lore_RK_BOMBLAUNCHER_ANTIBIO_REPAIR\"]"
msgstr ""
"Tampon de qualité : \"Flexibilité permettant aux auto-vaisseaux PARTOUT de "
"mettre plus de MEURTRE dans leurs emplacements d'armes !\""

#: src-en/data/text_misc.xml.append:62
msgid "data/text_misc.xml.append$//text[@name=\"lore_RK_MISSLAUNCHER_2_BATTERY\"]"
msgstr ""
"Tampon de qualité : \"A SAUVÉ la mise quand les autorités ont essayé de "
"neutraliser les armes de KILLER LEE. Ils sont morts à la place !\""

#: src-en/data/text_misc.xml.append:63
msgid "data/text_misc.xml.append$//text[@name=\"lore_RK_KILLALL_BEAM\"]"
msgstr ""
"Tampon de qualité : \"Des capitaines de test externalisés ont rapporté "
"d'INNOMBRABLES éliminations ! Mais les mutineries ont coûté la vie à 89 % "
"d'entre eux.\""

#: src-en/data/text_misc.xml.append:64
msgid "data/text_misc.xml.append$//text[@name=\"lore_RK_RAIN_OF_ION\"]"
msgstr ""
"Tampon de qualité : \"42 ÉLIMINATIONS CONFIRMÉES de races de la Fédération "
"par suffocation, convulsions et autres causes !\""

#: src-en/data/text_misc.xml.append:65
msgid "data/text_misc.xml.append$//text[@name=\"lore_RK_SHOTPHASER\"]"
msgstr ""
"Tampon de qualité : \"DÉBOUCLÉ tous les Défenseurs d'Orphelinat sur le "
"chemin de SLAVER KURT. Redditions très lucratives !\""

#: src-en/data/text_misc.xml.append:67
msgid "data/text_misc.xml.append$//text[@name=\"lore_RK_BOMBLAUNCHER_OXYBOTTLE\"]"
msgstr ""
"Tampon de qualité : \"A aidé les Esclavagistes recherchés à éviter la "
"suffocation ET à exercer leur vengeance sur les Lanius qui l'ont causée !\""

#: src-en/data/text_misc.xml.append:68
msgid ""
"data/text_misc.xml.append$//text[@name=\"RK_lore_RK_OXY_FIREFILL_MISSILES\"]"
msgstr ""
"Tampon de qualité : \"Beaucoup ont déclaré que c'était un 'CRIME DE GUERRE "
"ODIEUX'. D'autres, principalement des Rocailleux, ont épousé le leur !\""

#: src-en/data/text_misc.xml.append:69
msgid "data/text_misc.xml.append$//text[@name=\"RK_lore_RK_FOCUS_FIRE\"]"
msgstr ""
"Tampon de qualité : \"Autrefois élu 'Arme du cycle' par 'INFERNAL NEWS' et "
"'SCORCHING STONES' !\""

#: src-en/data/text_misc.xml.append:70
msgid "data/text_misc.xml.append$//text[@name=\"RK_lore_DJMOD_RAIN_OF_FIRE\"]"
msgstr ""
"Tampon de qualité : \"Alimenté par des Orchidées D'ÉLITE liquéfiées ! A "
"brûlé des vaisseaux Fantômes ET Rocailleux !\""

#: src-en/data/text_misc.xml.append:72
msgid "data/text_misc.xml.append$//text[@name=\"RK_lore_RK_BPS_FOCUS_STATUS\"]"
msgstr ""

#: src-en/data/text_misc.xml.append:73
msgid "data/text_misc.xml.append$//text[@name=\"RK_lore_DJMOD_LASER_BPS\"]"
msgstr ""
"Tampon de qualité : \"A démontré la performance RK en éliminant un vaisseau "
"habité de CHAQUE faction naturelle et non naturelle !\""

#: src-en/data/text_misc.xml.append:75
msgid "data/text_misc.xml.append$//text[@name=\"lore_RK_A_HULL_DAMAGE\"]"
msgstr ""
"Les meilleurs Lasers de défense, avec des améliorations de haute précision "
"adaptées aux faiblesses spécifiques de l'équipement RadiKal."

#: src-en/data/text_misc.xml.append:76
msgid "data/text_misc.xml.append$//text[@name=\"lore_RK_A_SYSTEM_DAMAGE\"]"
msgstr ""
"Les meilleurs Lanceurs Momus, avec des améliorations de haute précision "
"adaptées aux faiblesses spécifiques de l'équipement RadiKal."
