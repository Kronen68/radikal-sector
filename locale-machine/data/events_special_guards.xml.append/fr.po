"data/events_special_guards.xml.append$//event[@name=\"GUARD_RADIKAL_DEADCREW\"]/choice[2]/text"
msgstr ""

#: src-en/data/events_special_guards.xml.append:343
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"GUARD_RADIKAL_DEADCREW\"]/choice[2]/event/text"
msgstr "Vous trouvez de l'équipement RadiKal supplémentaire !"

#: src-en/data/events_special_guards.xml.append:347
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"GUARD_RADIKAL_DEADCREW\"]/choice[2]/event/choice/text"
msgstr ""

#: src-en/data/events_special_guards.xml.append:370
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"GUARD_RADIKAL_FOLLOWUP\"]/text"
msgstr ""
"En tuant le garde RadiKal, vous ne faites aucun doute qu'ils ont envoyé des "
"renforts pour vous traquer. Faites attention où vous mettez les pieds en "
"explorant le secteur."

#: src-en/data/events_special_guards.xml.append:378
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"GUARD_RADIKAL_FOLLOWUP\"]/choice[1]/text"
msgstr ""

