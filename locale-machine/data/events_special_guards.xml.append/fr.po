msgid ""
"data/events_special_guards.xml.append$//event[@name=\"GUARD_RADIKAL_DEADCREW\"]/choice[2]/text"
msgstr ""

#: src-en/data/events_special_guards.xml.append:343
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"GUARD_RADIKAL_DEADCREW\"]/choice[2]/event/text"
msgstr "Tu trouves de l'équipement RadiKal supplémentaire !"

#: src-en/data/events_special_guards.xml.append:347
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"GUARD_RADIKAL_DEADCREW\"]/choice[2]/event/choice/text"
msgstr ""

#: src-en/data/events_special_guards.xml.append:370
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"GUARD_RADIKAL_FOLLOWUP\"]/text"
msgstr ""
"En tuant le gardien RadiKal, tu les as sans aucun doute amenés à envoyer des"
" renforts pour te traquer. Fais attention à tes pas en explorant le secteur."

#: src-en/data/events_special_guards.xml.append:378
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"GUARD_RADIKAL_FOLLOWUP\"]/choice[1]/text"
msgstr ""

#: src-en/data/events_special_guards.xml.append:382
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"GUARD_RADIKAL_FOLLOWUP\"]/choice[2]/text"
msgstr ""

#: src-en/data/events_special_guards.xml.append:391
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"REINFORCEMENTS_RADIKAL\"]/beaconType/unvisitedTooltip"
msgstr ""

#: src-en/data/events_special_guards.xml.append:392
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"REINFORCEMENTS_RADIKAL\"]/beaconType/visitedTooltip"
msgstr ""

#: src-en/data/events_special_guards.xml.append:393
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"REINFORCEMENTS_RADIKAL\"]/beaconType/undiscoveredTooltip"
msgstr ""

#: src-en/data/events_special_guards.xml.append:395
msgid ""
"data/events_special_guards.xml.append$//event[@name=\"REINFORCEMENTS_RADIKAL\"]/text"
msgstr ""
"Tu comprends facilement le message général de ce vaisseau : Quelqu'un doit être le gardien, ils faisaient juste leur travail, et connaissaient les risques. Mais toi aussi !\n"
"\t\tLes renforts RadiKal attaquent !"

