					</choice>
				</event>
			</choice>
		</event>
	</choice>
	<choice req="DJMOD_HAS_RADIKAL_GEAR" lvl="1" hidden="true" blue="true">
		<text>...I don't like this one bit. Try to run!</text>
		<event><loadEvent>RK_A_OUTSIDE_POLICE_RK_DETECTED_ATTACK</loadEvent></event>
	</choice>
</event>
