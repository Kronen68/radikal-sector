<!--
		BUYERS - MAX 2 BEACONS, else could crash because uniques.
	Events that can remove gear and add resources.
-->
<eventList name="RK_GEAR_BUYERS">
	<event load="RK_GEAR_BUYER_ROCKMAN"/>
	<event load="RK_GEAR_BUYER_ZOLTAN"/>
</eventList>

<event name="RK_GEAR_BUYER_ROCKMAN" unique="true">
<!-- <event name="RK_GEAR_BUYER_ROCKMAN"> -->
	<!-- <preventQuest/> -->
	<text>You notice a Theocracy ship nearby, they immediately hail you.</text>
	<!-- <ship load="SHIP_ROCK_ESCORT_LARGE" hostile="false"/> Has a whole questline triggering mid-fight... -->
	<ship load="SHIP_ROCK_ELITE_GENERIC" hostile="false"/>
	<choice hidden="true">
		<text>Take the hail.</text>
		<event>
			<text>"Greetings, pagan. We buy RadiKal weapons, and we believe you have some. We pay even more than their usual buy price."</text>
			
			<choice>
				<text>"Is that so?"</text>
				<event>
					<text>"..."</text>
					
					<choice>
						<text>"..."</text>
						<event>
							<text>"... ..."</text>
							
							<choice>
								<text>"... ... ..."</text>
								<event>
									<text>You realize they are not going to elaborate, and start considering it. What do you decide?</text>
									<!-- Sell for 150% of value, except BPS weapons, which pass all checks so 200%. -->

									<choice req="DJMOD_BAM_FISSUREBEAM" hidden="true">
										<text>Sell them your Bada beam for 165~.</text>
										<event>
											<text>You try to hide your satisfaction while they transfer the excessive payment, but also hope some unfortunate encounter won't make you regret the sale in the near future. They leave without a word.</text>
											<remove name="DJMOD_BAM_FISSUREBEAM"/>
											<item_modify>
												<item type="scrap" min="165" max="165"/>
											</item_modify>
										</event>
									</choice>
									<choice req="RK_HEAVY_POPPER_1" hidden="true">
										<text>Sell them your Heavy Popper MK I laser for 90~.</text>
										<event>
											<text>You try to hide your satisfaction while they transfer the excessive payment, but also hope some unfortunate encounter won't make you regret the sale in the near future. They leave without a word.</text>
											<remove name="RK_HEAVY_POPPER_1"/>
											<item_modify>
												<item type="scrap" min="90" max="90"/>
											</item_modify>
										</event>
									</choice>
									<choice req="RK_HEAVY_POPPER_2" hidden="true">
										<text>Sell them your Heavy Popper MK II laser for 120~.</text>
										<event>
											<text>You try to hide your satisfaction while they transfer the excessive payment, but also hope some unfortunate encounter won't make you regret the sale in the near future. They leave without a word.</text>
											<remove name="RK_HEAVY_POPPER_2"/>
											<item_modify>
												<item type="scrap" min="120" max="120"/>
											</item_modify>
										</event>
									</choice>
									<choice req="RK_HEAVY_POPPER_3" hidden="true">
										<text>Sell them your Heavy Popper MK III laser for 210~.</text>
										<event>
											<text>You try to hide your satisfaction while they transfer the excessive payment, but also hope some unfortunate encounter won't make you regret the sale in the near future. They leave without a word.</text>
											<remove name="RK_HEAVY_POPPER_3"/>
											<item_modify>
												<item type="scrap" min="210" max="210"/>
											</item_modify>
										</event>
									</choice>
									<choice req="RK_UNLOADER" hidden="true">
										<text>Sell them your Unloader launcher for 105~.</text>
										<event>
											<text>You try to hide your satisfaction while they transfer the excessive payment, but also hope some unfortunate encounter won't make you regret the sale in the near future. They leave without a word.</text>
											<remove name="RK_UNLOADER"/>
											<item_modify>
												<item type="scrap" min="105" max="105"/>
											</item_modify>
										</event>
									</choice>

									<choice req="RK_BOMBLAUNCHER_ANTIBIO_REPAIR" hidden="true">
										<text>Sell them your Radiation Repair bomb for 75~.</text>
										<event>
											<text>You try to hide your satisfaction while they transfer the excessive payment, but also hope some unfortunate encounter won't make you regret the sale in the near future. They leave without a word.</text>
											<remove name="RK_BOMBLAUNCHER_ANTIBIO_REPAIR"/>
											<item_modify>
												<item type="scrap" min="75" max="75"/>
											</item_modify>
										</event>
									</choice>
									<choice req="RK_KILLALL_BEAM" hidden="true">
