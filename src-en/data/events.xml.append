<!-- 
/////////////////////////////////////////////////////////////////////////////////////////////////////////
*********************************************************************************************************
				OUTSIDE OF RK SECTOR EVENTS
				Mostly for Anti-RK content, adding lore and the risk to having RK gear.
*********************************************************************************************************
/////////////////////////////////////////////////////////////////////////////////////////////////////////
-->
<!-- Using a switcher because loc_sector_count is dumb for S1 and S2. NOT REALLY WORKING. CONSOLES FINE THOUGH.
 Leaving for when i try to fix this again, and just in case. -->
<event name="RK_A_OUTSIDE_POLICE_INTRO_QUEST_START_SWITCHER">
	<!-- <loadEventList seeded="false" first="false" generate="false"> 	generate=true needed to spawn the map marker. -->
	<loadEventList seeded="false" first="false" generate="true">
		<event name="RK_A_OUTSIDE_POLICE_INTRO_QUEST_START" req="rk_a_outside_police_intro_done" lvl="0" max_lvl="0"/>
		<!-- unique="true" for beacons is only within the sector, not the run!
		<event name="RK_A_OUTSIDE_POLICE_INTRO_QUEST_START"/> -->
		
		<event name="FILLER_LIST" req="rk_a_outside_police_intro_done" lvl="1"/>
		<!-- <event name="FILLER_LIST"/> -->
	</loadEventList>
</event>

<!-- <event name="RK_A_OUTSIDE_POLICE_INTRO_QUEST_START"> -->
<event name="RK_A_OUTSIDE_POLICE_INTRO_QUEST_START" unique="true">
	<!-- No beacon marker, police checks must be ambushes. TEMP FOR DEBUGGING-->
	<!-- <beaconType id="map_icon_task" global="true">
		<color r="255" g="255" b="140" a="1.0"/>
		<unvisitedTooltip>RK_A POLICE INTRO</unvisitedTooltip>
		<visitedTooltip>Explored location. Nothing left of interest.</visitedTooltip>
		<undiscoveredTooltip>An unvisited location.</undiscoveredTooltip>
	</beaconType> -->

	<preventQuest />
    <quest>
        <removeNebula>true</removeNebula>
        <nextSector>true</nextSector>
        <aggressive>2</aggressive>
    </quest>
	<text>A ship with very special offensive, defensive and intelligence equipment in Elite colors is here.
		They must be on high alert judging by how fast they hail you.</text>
	<ship load="SHIP_RK_A_ZOLTAN_POLICE_INTRO" hostile="false"/>

	<metaVariable name="rk_a_outside_police_intro_done" op="add" val="1"/>

	<choice req="DJMOD_HAS_RADIKAL_GEAR" lvl="0" max_lvl="0" hidden="true" blue="false">
		<text>You do not have any RadiKal (RK) gear at all. That might have just saved you.</text>
		<event load="OPTION_INVALID"/>
	</choice>
	
	<choice req="DJMOD_HAS_RADIKAL_GEAR" lvl="0" max_lvl="0" hidden="true" blue="false">
		<text>Take the hail</text>
		<event>
			<text>"Hello citizens. Do you know anything about the RadiKals? Also known as 'RK'."</text>

			<choice hidden="true">
				<text>Do we know any radicals? I wouldn't say so.</text>
				<event>
					<text>"That's not quite what I mean. Then allow me to educate you on this matter of public safety.
						
						RK is a semi-secret group of bad people who do bad things, and incite others do the same by selling them the bad things they made.
						You look like an upstanding citizen since you don't have anything RadiKal. Yes, we have deep-scanned your ship, twice for good measure.</text>
					
					<choice hidden="true">
						<text>Whoa OK, respecting privacy much?</text>
						<event>
							<text>"Don't be a hipster, everybody knows 'privacy' died sometime around the early 21st century. Back to the topic.
						
							We are proudly part of the Anti-RadiKal Secret Service (ARKSS). We wouldn't normally tell you this, but we ne- ... could use more hands, and you look capable.
							If you wish to ensure your own safety, or even join the good fight against them, we sell the right tools that you won't find anywhere else."</text>
							
							<choice hidden="true">
								<text>Hmmm fine, let's see.</text>
								<event>
									<text>"Good. Don't let it fall into the wrong hands.
										
										And if you encounter any of that scum afterwards: do not take their hails, aim for the head, and 'May Order Prevail'."</text>
									<store>STORE_ANTI_RADIKAL</store>
								</event>
							</choice>
						</event>
					</choice>
				</event>
			</choice>

			<choice hidden="true">
				<text>They went that way.</text>
				<event>
					<text>"Thank you for your cooperation." They immediately throw a reward package through an airlock and depart. Hopefully, by some odds there actually are RadiKals that way, or you better hope you never see this ship again.</text>
