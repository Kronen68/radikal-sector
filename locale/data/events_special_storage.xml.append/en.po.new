msgid ""
"data/events_special_storage.xml.append$//event[@name=\"DJMOD_COMBAT_SHIPVORE_RAM_TIMER_END_FULL_POWER\"]/choice[4]/text"
msgstr "Abort, and retrieve any non consumed {."

#: src-en/data/events_special_storage.xml.append:1106
msgid ""
"data/events_special_storage.xml.append$/dummyroot/FTL/event[@name=\"SHIPVORE_RAM_ATTACK_2DMG_NOTHING\"]/text"
msgstr ""
"You barely manage to hit the enemy hull (and [style[color:ff3377]]missed all"
" systems[[/style]]), dealing 2 damage..."

#: src-en/data/events_special_storage.xml.append:1110
msgid ""
"data/events_special_storage.xml.append$/dummyroot/FTL/event[@name=\"SHIPVORE_RAM_ATTACK_2DMG_NOTHING\"]/choice/text"
msgstr "...with this result on your own ship (75% chance good)."

#: src-en/data/events_special_storage.xml.append:1115
msgid ""
"data/events_special_storage.xml.append$/dummyroot/FTL/event[@name=\"SHIPVORE_RAM_ATTACK_3DMG_NOTHING\"]/text"
msgstr ""
"You catch a small part of the enemy ship (but [style[color:ff3377]]missed "
"all systems[[/style]]), dealing 3 damage..."

#: src-en/data/events_special_storage.xml.append:1119
msgid ""
"data/events_special_storage.xml.append$/dummyroot/FTL/event[@name=\"SHIPVORE_RAM_ATTACK_3DMG_NOTHING\"]/choice/text"
msgstr "...with this result on your own ship (75% chance good)."

#: src-en/data/events_special_storage.xml.append:1125
msgid ""
"data/events_special_storage.xml.append$/dummyroot/FTL/event[@name=\"SHIPVORE_RAM_ATTACK_3DMG_BREACH\"]/text"
