"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_SYSTEM_DJMOD_RADIKAL_INTERNAL_RK_IN_FIRE_CREWBOOSTS\"]/choice[@req=\"pilot\"]/text"
msgstr "Nevermind."

#: src-en/data/events_special_storage.xml.append:7400
msgid ""
"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_SYSTEM_DJMOD_RADIKAL_INTERNAL_DJMOD_MC_IMMUNE_FROM_FIRE\"]/text"
msgstr ""
"You are about to install the Mind Heater upgrade.\n"
"\t[Effects: In fire, your crew are immune to Mind Control and cured from it, stunned 50% shorter, and reveal adjacent rooms, on both ships.]"

#: src-en/data/events_special_storage.xml.append:7404
msgid ""
"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_SYSTEM_DJMOD_RADIKAL_INTERNAL_DJMOD_MC_IMMUNE_FROM_FIRE\"]/choice[@req=\"DJMOD_HAS_RADIKAL_SCORCH_GEAR\""
" and @lvl=\"0\"]/text"
msgstr ""
"This upgrade is unavailable. You need any RadiKal Scorch (or BPS) "
"weapon/augment/crew/ship."

#: src-en/data/events_special_storage.xml.append:7408
msgid ""
"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_SYSTEM_DJMOD_RADIKAL_INTERNAL_DJMOD_MC_IMMUNE_FROM_FIRE\"]/choice[@req=\"DJMOD_HAS_RADIKAL_SCORCH_GEAR\""
" and @lvl=\"1\"]/text"
msgstr "Perform the upgrade. [Cost: 30~, 1{, 1|]"

#: src-en/data/events_special_storage.xml.append:7410
msgid ""
"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_SYSTEM_DJMOD_RADIKAL_INTERNAL_DJMOD_MC_IMMUNE_FROM_FIRE\"]/choice[@req=\"DJMOD_HAS_RADIKAL_SCORCH_GEAR\""
" and @lvl=\"1\"]/event/text"
msgstr "You install the upgrade."

#: src-en/data/events_special_storage.xml.append:7417
msgid ""
"data/events_special_storage.xml.append$//event[@name=\"STORAGE_CHECK_SYSTEM_DJMOD_RADIKAL_INTERNAL_DJMOD_MC_IMMUNE_FROM_FIRE\"]/choice[@req=\"DJMOD_HAS_RADIKAL_SCORCH_GEAR\""
" and @lvl=\"1\"]/event/choice/text"
msgstr "Continue..."

