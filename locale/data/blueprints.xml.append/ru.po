#: src-en/data/blueprints.xml.append:188
msgid ""
"data/blueprints.xml.append$//crewBlueprint[@name=\"rk_bottledoxygen\"]/desc"
msgstr "Баллон кислорода. Пополняет запас кислорода."

#: src-en/data/blueprints.xml.append:190
msgid ""
"data/blueprints.xml.append$//crewBlueprint[@name=\"rk_bottledoxygen\"]/title"
msgstr "Баллон кислорода"

#: src-en/data/blueprints.xml.append:191
msgid ""
"data/blueprints.xml.append$//crewBlueprint[@name=\"rk_bottledoxygen\"]/short"
