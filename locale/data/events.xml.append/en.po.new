#: src-en/data/events.xml.append:2126
msgid ""
"data/events.xml.append$//event[@name=\"RADIKAL_ENSLAVED_GOODEND_MANTIS\"]/choice/text"
msgstr "I think they'll fit right in."

#: src-en/data/events.xml.append:2131
msgid ""
"data/events.xml.append$//event[@name=\"RADIKAL_ENSLAVED_GOODEND_RK_WEAPONLIKE\"]/text"
msgstr ""
"They bring you the slave (actually a pair of them) and remove their "
"restraints, apparently relieved to get rid of him. \"Drive.\" is all they "
"say. You diplomatically nod and welcome them aboard."

#: src-en/data/events.xml.append:2134
msgid ""
"data/events.xml.append$//event[@name=\"RADIKAL_ENSLAVED_GOODEND_RK_WEAPONLIKE\"]/choice/text"
msgstr "I think they'll fit right in."

#: src-en/data/events.xml.append:2139
msgid ""
"data/events.xml.append$//event[@name=\"RADIKAL_ENSLAVED_GOODEND_RK_FIREGHOST\"]/text"
msgstr ""
"They bring you the slave and remove his restraints, apparently relieved to "
"get rid of him. \"I wasn't stuck in there with them. They were stuck in "
"there with me.\" says the freshly freed troublesome slave. You "
"diplomatically nod and welcome them aboard."

#: src-en/data/events.xml.append:2142
msgid ""
"data/events.xml.append$//event[@name=\"RADIKAL_ENSLAVED_GOODEND_RK_FIREGHOST\"]/choice/text"
msgstr "I think they'll fit right in."

#: src-en/data/events.xml.append:2148
msgid ""
"data/events.xml.append$//event[@name=\"RADIKAL_ENSLAVED_BADEND_LOSTSUN\"]/text"
msgstr ""
"They bring you the slave and remove his restraints so quickly that you haven't even transferred all the scrap yet. Unfortunately the troublemaker doesn't seem to like the way some of your crew look at him, and starts punching! \n"
"\tYou interrupt the scrap transfer and watch the slavers immediately jump away, leaving you to deal with him."

#: src-en/data/events.xml.append:2157
msgid ""
"data/events.xml.append$//event[@name=\"RADIKAL_ENSLAVED_BADEND_LOSTSUN\"]/choice/text"
msgstr "So that's why he was so cheap."

#: src-en/data/events.xml.append:2162
msgid ""
"data/events.xml.append$//event[@name=\"RADIKAL_ENSLAVED_BADEND_DUSKBRINGER\"]/text"
msgstr ""
