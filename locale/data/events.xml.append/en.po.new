msgid ""
"data/events.xml.append$//event[@name=\"RK_SURRENDER_GEAR_TO_RK_A\"]/choice[@req=\"RK_FOCUS_FIRE\"]/event/choice/text"
msgstr "Continue..."

#: src-en/data/events.xml.append:1830
msgid ""
"data/events.xml.append$//event[@name=\"RK_SURRENDER_GEAR_TO_RK_A\"]/choice[@req=\"DJMOD_RAIN_OF_FIRE\"]/text"
msgstr "Surrender your Rain of Fire launcher."

