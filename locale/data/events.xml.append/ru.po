#: src-en/data/events.xml.append:4064
msgid "data/events.xml.append$//event[@name=\"THIEVES_RK_BEAMS\"]/text"
msgstr ""
"Похоже, поврежденный корабль РадиКалов, вооруженный лучевым оружием, "
