#: src-en/data/events.xml.append:4247
msgid ""
"data/events.xml.append$//event[@name=\"EXIT_RADIKAL_MAIN\"]/choice[@req=\"unique_alkali\"]/text"
msgstr "(Алькали) Пусть Алькали попросит вас пропустить."

#: src-en/data/events.xml.append:4249
msgid ""
"data/events.xml.append$//event[@name=\"EXIT_RADIKAL_MAIN\"]/choice[@req=\"unique_alkali\"]/event/text"
msgstr ""
"К счастью, проходит всего несколько минут, и Алькали возвращается, после "
