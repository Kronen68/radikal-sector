#: src-en/data/events.xml.append:2063
msgid ""
"data/events.xml.append$//event[@name=\"RADIKAL_ENSLAVED\"]/choice[1]/event/choice[2]/text"
msgstr "Отказаться."

#: src-en/data/events.xml.append:2070
