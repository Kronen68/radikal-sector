#: src-en/data/events.xml.append:730
msgid ""
"data/events.xml.append$//event[@name=\"RK_A_OUTSIDE_POLICE_NUMBER2_QUEST_START\"]/choice[3]/event/choice[@req=\"RK_HAS_GEAR_SURRENDERABLE_TO_RK_A\""
" and @lvl=\"0\"]/text"
msgstr "Nothing to declare, officer."

#: src-en/data/events.xml.append:732
msgid ""
"data/events.xml.append$//event[@name=\"RK_A_OUTSIDE_POLICE_NUMBER2_QUEST_START\"]/choice[3]/event/choice[@req=\"RK_HAS_GEAR_SURRENDERABLE_TO_RK_A\""
" and @lvl=\"0\"]/event/text"
msgstr "\"Good. Have you seen any RadiKals in this sector?\""

#: src-en/data/events.xml.append:735
msgid ""
"data/events.xml.append$//event[@name=\"RK_A_OUTSIDE_POLICE_NUMBER2_QUEST_START\"]/choice[3]/event/choice[@req=\"RK_HAS_GEAR_SURRENDERABLE_TO_RK_A\""
" and @lvl=\"0\"]/event/choice[1]/text"
msgstr "I don't think I have."

#: src-en/data/events.xml.append:737
msgid ""
"data/events.xml.append$//event[@name=\"RK_A_OUTSIDE_POLICE_NUMBER2_QUEST_START\"]/choice[3]/event/choice[@req=\"RK_HAS_GEAR_SURRENDERABLE_TO_RK_A\""
" and @lvl=\"0\"]/event/choice[1]/event/text"
msgstr ""
"\"Also good. Now, if you wish to acquire Anti-RK equipment, feel free to gear up. We are the only organization authorized to sell it.\n"
"\t\t\t\t\t\t\t\t'May Order Prevail'.\""

#: src-en/data/events.xml.append:745
msgid ""
