msgstr "(Orchid Praetor) Gesture \"We come to help\"."

#: src-en/data/events.xml.append:3327
msgid ""
"data/events.xml.append$//event[@name=\"ZOLTAN_POLICECHECK_RK_MENU\"]/choice[@req=\"orchid_praetor\"]/event/text"
