#: src-en/data/events.xml.append:2907
msgid ""
"data/events.xml.append$//event[@name=\"RK_GEAR_BUYER_ZOLTAN\"]/choice[1]/event/choice[1]/event/choice/event/choice[1]/event/choice[22]/event/text"
msgstr ""
"이 만남을 통해 얻을 수 있었던 이익을 생각하지만, 지나가는 행인에게 무기를 파는 것은 그다지 안전한 전략이 아니라는 것도 기억합니다.\n"
"\t\t\t\t\t\t\t\t\t\t\t\t그래도 함선 안에서 다른 일을 할 시간은 남아있습니다."

#: src-en/data/events.xml.append:2912
msgid ""
"data/events.xml.append$//event[@name=\"RK_GEAR_BUYER_ZOLTAN\"]/choice[1]/event/choice[1]/event/choice/event/choice[1]/event/choice[22]/event/choice[1]/text"
