#: src-en/data/events_sector_radikal.xml:2210
msgid ""
"data/events_sector_radikal.xml$//ship[@name=\"SHIP_RKS_DEFROMORIUS_SUSPICIOUS\"]/surrender/text"
msgstr ""
"\"우리가 한 게 아니야! 리사의 이름을 걸고 빌 테니 제발 멈춰! 전부 다 말해줄게!\"\n"
"\t\t\t\n"
"\t\t\t\"잠깐, 그게 나랑 무슨 상관인데? 저 사람들은 내 이름조차 모-... 아, 아무튼 됐어.\""

#: src-en/data/events_sector_radikal.xml:2216
msgid ""
"data/events_sector_radikal.xml$//ship[@name=\"SHIP_RKS_DEFROMORIUS_SUSPICIOUS\"]/surrender/choice[1]/text"
msgstr "좋습니다, 그럼 누가 이런 짓을 했습니까?"

#: src-en/data/events_sector_radikal.xml:2218
msgid ""
"data/events_sector_radikal.xml$//ship[@name=\"SHIP_RKS_DEFROMORIUS_SUSPICIOUS\"]/surrender/choice[1]/event/text"
msgstr ""
"\"우린 그냥 우리 할 일을 하면서 장신구를 팔러 이 부두로 가던 길이었어...\"\n"
"\t\t\t\t\t언제든 \"발포하라\"는 신호를 보낼 준비를 하고 그들의 눈을 노려보자, 놈들은 얼른 신빙성 있게 진술을 수정합니다.\n"
"\t\t\t\t\t\n"
"\t\t\t\t\t\"좋아, 어쩌면 우리가 몰래 그 엔지들에게 신경 충격기 한두 개를 팔고 있었을지도 모오오올라. 하지만 갑자기 놈들이 이상하게 굴기 시작하더니 조난 신호를 보내는 거야. 그저 겸손한 상인일 뿐인 우리는 당장 여기서 튀어야 한다는 신호로 받아들였지! 맞지, 리사?\"\n"
"\n"
"\t\t\t\t\t\"그냥 왕복선 얘기나 해, 이 멍청아! 미친 소리 하지 말고 팩트만 말하라고.\"\n"
"\n"
"\t\t\t\t\t\"아 그래, 맞다! 탈출하는 그 조그만 선박을 감지했는데, 스캔해 보니 내부에서 엄청난 괴물이 찍혔어! 무슨 프랑켄슈타인 같은 게 말이지! 이거 봐, 그놈이 진짜 범인이 틀림없어. 분명 내부자의 소행이라니까!\"\n"
"\t\t\t\t\t놈들은 온갖 음모론을 횡설수설 늘어놓기 시작하고, 뒤에 있던 \"리사\"는 놈의 정신 건강을 진심으로 걱정하는 표정을 짓습니다."

#: src-en/data/events_sector_radikal.xml:2231
