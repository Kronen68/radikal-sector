#: src-en/data/events_sector_radikal.xml:577
msgid "data/events_sector_radikal.xml$//event[@name=\"RKS_FIGHT_WOF\"]/text"
msgstr ""
"도약을 마친 지 얼마 되지도 않아, 당신의 함선 바로 앞에 작지만 몹시 화가 난 듯한 RK 스코치 함선 한 대가 나타나 공개 통신으로 빠르게 고성을 지르고 있습니다.\n"
"\t\t\"찾았다! 감히 우리 배송품에 손을 대다니, 더러운 용병 녀석! 부정할 생각 마라. 죽어라! 불타라!\"\n"
"\t\t당신은 그들이 오해하고 있다고 설명하려 하지만, 놈들은 당신을 몰아붙이기 위해 빠르게 무기를 가열하고 있습니다.\n"
"\n"
"\t\t탈출 도구가 있거나 놈들을 설득할 아주 결정적인 수단이 없다면, 결국 전투를 피할 수 없을 것 같습니다!"

#: src-en/data/events_sector_radikal.xml:587
msgid ""
"data/events_sector_radikal.xml$//event[@name=\"RKS_FIGHT_WOF\"]/choice[@req=\"unique_rk_defromorius\"]/text"
msgstr "(데프로모리우스) 저들에게 물러서라고 말한다."

#: src-en/data/events_sector_radikal.xml:589
msgid ""
"data/events_sector_radikal.xml$//event[@name=\"RKS_FIGHT_WOF\"]/choice[@req=\"unique_rk_defromorius\"]/event/text"
msgstr ""
"\"--새로운 목표: 상황 진정-- 정지하십시오. 안녕하십니까.\"\n"
"\n"
"\t\t\t\t\"이런 젠장, 놈들이 데프로모리우스님을 포획했다! 죽어라 이 쓰레-\" 발포를 시작하기도 전에 다른 선원이 함장의 말을 막아섭니다. \"멍청하게 굴지 말고 진정하고 다시 좀 보세요!\" \"뭐? 잠깐. 어, 어라! 죄송합니다, 지휘관님. 이런 실수를 안 하려면 가끔은 정말 머리 좀 식혀야겠네요. 사과의 의미로 이걸 드립니다. 나중에 뵙겠습니다, 지휘관님!\" 놈들은 숨도 돌리지 않고 즉시 부함장에게 돌아서서 소리칩니다. \"진짜 그 개자식들을 찾아라!\""

